{
  "name": "kboa-academy-app",
  "version": "1.0.0",
  "description": "KBOA - Knowledge Bridge Online Academy Android App",
  "main": "index.html",
  "scripts": {
    "sync": "npx cap sync android",
    "open:android": "npx cap open android",
    "build:android": "npx cap sync android && cd android && ./gradlew assembleRelease",
    "build:apk": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "run:device": "npx cap run android --target",
    "check": "node --check js/auth.js && node --check js/data.js && node --check js/certificates/certificate-generator.js && node --check admin/js/admin-data.js",
    "test:phase3": "node tests/phase3-static.js",
    "test:phase4": "node tests/phase4-static.js",
    "test:phase5": "node tests/phase5-static.js",
    "test:production": "npm run check && npm run test:phase3 && npm run test:phase4 && npm run test:phase5 && npm run test:phase6 && npm run test:phase7 && npm run test:phase8 && npm run test:e2e:contract && npm run test:phase10 && npm run test:phase11 && npm run test:phase12 && npm run test:launch && npm run test:phase13 && npm run test:phase14 && npm run test:phase15 && npm run test:phase16 && npm run test:phase17 && npm run test:phase18 && npm run test:phase19",
    "test:phase6": "node tests/phase6-static.js",
    "test:emulator": "bash tests/run-emulator-smoke.sh",
    "test:phase7": "node tests/phase7-static.js",
    "test:phase8": "node tests/phase8-static.js",
    "test:e2e:contract": "node tests/e2e-contract.js",
    "test:phase9": "node tests/phase9-static.js",
    "test:rules": "bash tests/run-emulator-rules.sh",
    "test:e2e:browser": "bash tests/run-browser-e2e.sh",
    "test:deploy:gate": "node tests/deployment-gate.js",
    "test:phase10": "node tests/phase10-static.js",
    "test:health": "node tests/health-check.js",
    "test:phase11": "node tests/phase11-static.js",
    "test:launch": "node tests/launch-readiness.js",
    "test:phase11:production": "node tests/phase11-production.js",
    "test:phase12": "node tests/phase12-static.js",
    "test:phase13": "node tests/phase13-static.js",
    "test:phase14": "node tests/phase14-static.js",
    "test:phase15": "node tests/phase15-static.js",
    "test:phase16": "node tests/phase16-static.js",
    "test:phase17": "node tests/phase17-static.js",
    "test:phase18": "node tests/phase18-static.js",
    "test:phase19": "node tests/phase19-static.js",
    "test:student-auth": "node tests/student-auth-portal-static.js"
  },
  "dependencies": {
    "@capacitor/android": "^5.7.0",
    "@capacitor/core": "^5.7.0",
    "@capacitor/app": "^5.0.7",
    "@capacitor/push-notifications": "^5.1.1",
    "@capacitor/splash-screen": "^5.0.7",
    "@capacitor/status-bar": "^5.0.7",
    "@capacitor/network": "^5.0.7",
    "@capacitor/filesystem": "^5.2.1",
    "@capacitor/preferences": "^5.0.7",
    "@capacitor/share": "^5.0.7",
    "@capacitor/browser": "^5.2.0",
    "@capacitor/local-notifications": "^5.0.7",
    "@capacitor/device": "^5.0.7",
    "firebase": "^9.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.0",
    "@firebase/rules-unit-testing": "^3.0.4",
    "playwright": "^1.49.1"
  },
  "keywords": [
    "education",
    "lms",
    "academy",
    "android"
  ],
  "author": "KBOA Team",
  "license": "MIT"
}
